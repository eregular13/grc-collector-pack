{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "fullName": "Trivy Vulnerability Scanner",
          "rules": [
            {
              "id": "CVE-2023-0001",
              "name": "OsPackageVulnerability",
              "shortDescription": {"text": "critical openssl issue (fixture score)"},
              "defaultConfiguration": {"level": "error"},
              "properties": {
                "precision": "very-high",
                "security-severity": "9.8",
                "tags": ["vulnerability", "security", "CRITICAL"]
              }
            },
            {
              "id": "CVE-2019-1549",
              "name": "OsPackageVulnerability",
              "shortDescription": {"text": "openssl: information disclosure in fork()"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {
                "cvssv3_baseScore": 5.3,
                "precision": "very-high",
                "security-severity": "5.3",
                "tags": ["vulnerability", "security", "MEDIUM"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2023-0001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Package: libssl1.1\nVulnerability CVE-2023-0001\nSeverity: CRITICAL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/fixtures/images/alpine-310.tar.gz"
                }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2019-1549",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Package: libcrypto1.1\nVulnerability CVE-2019-1549\nSeverity: MEDIUM"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "testdata/fixtures/images/alpine-310.tar.gz"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
