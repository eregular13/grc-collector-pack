{
  "policy": {
    "name": "enforce-storage-encryption",
    "resource": "azure.storageaccount",
    "description": "Storage accounts without encryption at rest",
    "filters": [
      {
        "type": "value",
        "key": "properties.encryption.services.blob.enabled",
        "value": false
      }
    ]
  },
  "version": "0.9.35",
  "execution": {
    "start": 1
  }
}
