{
  "policy": {
    "name": "security-context-pods",
    "resource": "k8s.pod",
    "description": "Pods that do not set spec.securityContext",
    "filters": [
      {
        "type": "value",
        "key": "spec.securityContext",
        "value": "absent"
      }
    ]
  },
  "version": "0.9.35",
  "execution": {
    "start": 1
  }
}
