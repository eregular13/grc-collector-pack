{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "1.45.0",
          "rules": [
            {
              "id": "python.django.sql.extra-used",
              "name": "python.django.sql.extra-used",
              "shortDescription": { "text": "SQL interpolation via QuerySet.extra" },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "python.lang.security.insecure-hash",
              "name": "python.lang.security.insecure-hash",
              "shortDescription": { "text": "Insecure hash algorithm" },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.django.sql.extra-used",
          "level": "error",
          "message": { "text": "Detected Django extra() SQL interpolation." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/views.py" },
                "region": { "startLine": 88 }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.insecure-hash",
          "message": { "text": "Use of weak hash algorithm md5." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/tokens.py" },
                "region": { "startLine": 12 }
              }
            }
          ]
        }
      ]
    }
  ]
}
