# Consent bytes are hashed into SCOPE.yaml. Keep LF so Windows autocrlf
# cannot rewrite dropbox/consent/* and drift attestation_sha256.
dropbox/consent/** text eol=lf
dropbox/SCOPE.yaml text eol=lf
dropbox/SCOPE.example.yaml text eol=lf
# product-lab/drop MANIFEST SHA256 is of LF git blobs. Windows autocrlf
# would rewrite CSVs/JSON and fail tests/test_drop_manifest.py.
product-lab/drop/** text eol=lf
# LAB dest_in hardening drop (Lynis/OpenSCAP) SHA256 is of LF blobs.
fixtures/lab-drop/** text eol=lf
